{
  "name": "visualizador-mgv",
  "version": "1.0.0",
  "description": "Visualizador de preços MGV",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/WalaceLuisSousa/Visualizador_MGV.git"
  },

  "keywords": [
    "mgv",
    "balanca",
    "precos",
    "mercado"
  ],

  "author": "",
  "license": "ISC",
  "type": "commonjs",

  "bugs": {
    "url": "https://github.com/WalaceLuisSousa/Visualizador_MGV/issues"
  },

  "homepage": "https://github.com/WalaceLuisSousa/Visualizador_MGV#readme",

  "dependencies": {
    "express": "^5.2.1"
  },

  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },

  "build": {
    "appId": "br.omercadinho.visualizadormgv",

    "productName": "Visualizador MGV",

    "directories": {
